{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/clear-fetch-cache.ts && next build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/flatten-segments.ts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/write-headers.ts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/write-security-txt.ts",
    "start": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/serve-static.ts",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:matrix": "playwright test --config playwright.matrix.config.ts",
    "check:export": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-export.ts",
    "check:build-refuses": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-build-refuses.ts"
  },
  "dependencies": {
    "markdown-it": "15.0.3",
    "next": "16.4.6",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.0",
    "react-colorful": "5.8.1",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
