# Names only. Copy to .env and fill in locally. Never commit .env.
# What each one is for: docs/SECURITY-NOTES.md, "Operating".
DJANGO_SECRET_KEY=
AUDIT_CHAIN_KEY=
SITE_ORIGIN=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_EMAIL=
BOOTSTRAP_TOKEN_SHA256=
NOTIFIERS=core.notify.LogNotifier
DJANGO_ALLOWED_HOSTS=
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=
API_BASE_URL=
MEDIA_STORAGE=local
MEDIA_ROOT=
GCS_MEDIA_BUCKET=
CACHE_PURGER=core.purge.LogPurger
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=
SITE_DEPLOYER=core.deploy.LogDeployer
PAGES_DEPLOY_HOOK_URL=
# Turnstile secret. Empty refuses every contact message (the form fails closed).
# For local use Cloudflare's dummy secret 1x0000000000000000000000000000000AA
# (always passes); a real one comes from the Cloudflare dashboard.
TURNSTILE_SECRET_KEY=
# Site build: the data-request address shown on the Privacy page. Empty until set.
NEXT_PUBLIC_PRIVACY_EMAIL=
